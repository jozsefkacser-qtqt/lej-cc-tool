__pycache__/
*.py[cod]
.venv/
venv/
.env
# set-secrets.sh keeps a copy of the previous .env. Same secrets, same rules.
.env.backup-*
# Service-account keys and anything else credential-shaped. The Google key is
# a private key in a file whose name nobody recognises as dangerous, and a
# single `git add -A` would publish it.
/secrets/
*-service-account*.json
service-account.json
*.pem
*.p12
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Runtime state only - anchored so it cannot swallow tests/data/
/data/
*.db
*.sqlite3
downloads/
