#!/usr/bin/env bash
#
# Start, stop and check the AWB tracker on this machine.
#
#   awb restart     stop it, start it, wait until it is actually up
#   awb update      pull the latest code, then restart
#   awb status      is it running, since when, on what version
#   awb logs        follow the log
#   awb stop        stop it
#
# Why a pid file rather than `pkill -f lej-cc`: that pattern matches any
# process whose command line contains the string, which includes this script
# (it lives in lej-cc-tool/) -- so the restart would kill itself halfway
# through. The pid file is exact, and a process started the old way is
# adopted on the first run so there is never a second copy posting to Slack.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN="$ROOT/.venv/bin/lej-cc"
PIDFILE="${LEJ_CC_PIDFILE:-$ROOT/data/lej-cc.pid}"
LOG="${LEJ_CC_LOG:-$HOME/lej-cc.log}"
#: The bot drains in-flight polls and says goodbye in Slack before exiting.
STOP_TIMEOUT="${LEJ_CC_STOP_TIMEOUT:-25}"
START_TIMEOUT="${LEJ_CC_START_TIMEOUT:-30}"
MAX_LOG_BYTES="${LEJ_CC_MAX_LOG_BYTES:-10485760}"  # 10 MB

GREEN=$'\033[32m'; RED=$'\033[31m'; DIM=$'\033[2m'; OFF=$'\033[0m'
[[ -t 1 ]] || { GREEN=""; RED=""; DIM=""; OFF=""; }

die() { printf '%s✗ %s%s\n' "$RED" "$*" "$OFF" >&2; exit 1; }
ok()  { printf '%s✓ %s%s\n' "$GREEN" "$*" "$OFF"; }
dim() { printf '%s%s%s\n' "$DIM" "$*" "$OFF"; }

# --- finding the process ------------------------------------------------

alive() {
    # kill -0 asks the kernel, which cannot be truncated or misparsed.
    #
    # This used to grep `ps -p PID -o args=` for "lej-cc", and that was wrong
    # in a way that only showed up on a long path: ps cuts its output at 80
    # columns when stdout is not a terminal, so a checkout deep enough to
    # push the name past that made a running bot look dead -- `status` would
    # say "not running" and `start` would then start a second one, which is
    # the exact duplicate the pid file exists to prevent.
    kill -0 "$1" 2>/dev/null || return 1
    # A child nobody waited on lingers as a zombie, and kill -0 succeeds on
    # one. Not alive.
    local state
    state="$(ps -p "$1" -o stat= 2>/dev/null || true)"
    [[ "${state# }" != Z* ]]
}

is_our_bot() {
    # Only needed where a pid could have been reused by something else.
    # /proc is exact; `ps -ww` disables the column limit on everything else.
    local args=""
    if [[ -r "/proc/$1/cmdline" ]]; then
        args="$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null || true)"
    else
        args="$(ps -ww -p "$1" -o args= 2>/dev/null || true)"
    fi
    [[ "$args" == *lej-cc* ]]
}

running_pid() {
    local pid
    if [[ -f "$PIDFILE" ]]; then
        pid="$(cat "$PIDFILE" 2>/dev/null || true)"
        if [[ -n "$pid" ]] && alive "$pid" && is_our_bot "$pid"; then
            echo "$pid"
            return 0
        fi
    fi
    # Started by hand before this script existed, or the pid file was lost.
    # Adopt it: starting a second bot would double every Slack message.
    #
    # Not anchored with ^: a console script runs as ".../python .../lej-cc",
    # so the path is in the middle of the command line, not at the front.
    # Ended with ( |$) so lej-cc-doctor, which shares the prefix, is not
    # mistaken for the bot.
    pid="$(pgrep -f -- "$BIN( |\$)" 2>/dev/null | head -1 || true)"
    if [[ -n "$pid" ]]; then
        mkdir -p "$(dirname "$PIDFILE")"
        echo "$pid" > "$PIDFILE"
        echo "$pid"
        return 0
    fi
    rm -f "$PIDFILE"
    return 1
}

version() {
    git -C "$ROOT" describe --tags --always --dirty 2>/dev/null || echo "unknown"
}

SPAWNED_PID=""

spawn() {
    # The background job must be a plain command, not `( ... ) &` or
    # `a && b &`: those wrap it in a subshell that inherits -- and holds open
    # -- whatever stdout the caller had, so `awb autostart` from a script
    # would never return. Only the redirections below reach the bot.
    cd "$ROOT"
    nohup "$BIN" >> "$LOG" 2>&1 &
    SPAWNED_PID=$!
    echo "$SPAWNED_PID" > "$PIDFILE"
}

rotate_log() {
    local size
    size="$(stat -c %s "$LOG" 2>/dev/null || stat -f %z "$LOG" 2>/dev/null || echo 0)"
    if (( size > MAX_LOG_BYTES )); then
        mv "$LOG" "$LOG.1"
        dim "rotated the log (kept as $LOG.1)"
    fi
}

# --- commands -----------------------------------------------------------

cmd_start() {
    local pid
    if pid="$(running_pid)"; then
        ok "already running (pid $pid)"
        return 0
    fi
    [[ -x "$BIN" ]] || die "$BIN is missing. Set it up with: cd $ROOT && make dev"
    [[ -f "$ROOT/.env" ]] || die "$ROOT/.env is missing. Create it: cp .env.example .env"

    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOG")"
    # Create the log before anything reads it. On a first ever start it does
    # not exist, and a failed `< "$LOG"` redirect is reported before the
    # 2>/dev/null on the same line takes effect -- so the error escapes, and
    # whether it is fatal depends on the bash version. Deterministic instead.
    : >> "$LOG"
    if [[ -s "$LOG" ]]; then
        rotate_log
        : >> "$LOG"
    fi
    local mark
    mark="$(wc -l < "$LOG")"

    spawn
    pid="$SPAWNED_PID"
    printf 'starting'

    # A beat before the first look: between the fork and the exec the child
    # has not run a line of the bot yet, and judging it then is judging
    # nothing.
    sleep 1
    local waited=1
    while (( waited < START_TIMEOUT )); do
        if ! alive "$pid"; then
            printf '\n'
            printf '%s\n' "$DIM--- last lines of $LOG ---$OFF"
            tail -n 15 "$LOG" 2>/dev/null | sed "s/^/  /"
            rm -f "$PIDFILE"
            die "it started and then stopped. The lines above say why."
        fi
        if tail -n +"$((mark + 1))" "$LOG" 2>/dev/null | grep -q "lej-cc-tool ready"; then
            printf '\n'
            ok "running (pid $pid, $(version))"
            dim "log: $LOG    ·    follow it with: awb logs"
            return 0
        fi
        printf '.'
        sleep 1
        waited=$((waited + 1))
    done
    printf '\n'
    # Up but quiet: Socket Mode may still be connecting. Not a failure.
    ok "started (pid $pid) — no \"ready\" line yet after ${START_TIMEOUT}s"
    dim "check with: awb logs"
}

cmd_stop() {
    local pid
    if ! pid="$(running_pid)"; then
        ok "not running"
        return 0
    fi
    printf 'stopping (pid %s)' "$pid"
    kill -TERM "$pid" 2>/dev/null || true

    local waited=0
    while (( waited < STOP_TIMEOUT )) && alive "$pid"; do
        printf '.'
        sleep 1
        waited=$((waited + 1))
    done
    if alive "$pid"; then
        printf '\n'
        dim "it did not stop in ${STOP_TIMEOUT}s — forcing it"
        kill -KILL "$pid" 2>/dev/null || true
        sleep 1
    else
        printf '\n'
    fi
    rm -f "$PIDFILE"
    ok "stopped"
}

cmd_restart() {
    cmd_stop
    cmd_start
}

cmd_update() {
    if [[ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ]]; then
        dim "there are local changes in $ROOT — pulling anyway, nothing is discarded"
    fi
    local before after
    before="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo "?")"
    git -C "$ROOT" pull --ff-only || die "git pull failed — fix that first, nothing was restarted"
    after="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo "?")"

    if [[ "$before" == "$after" ]]; then
        dim "already up to date ($after)"
    else
        ok "updated $before → $after"
        # A new dependency in a new version would otherwise fail at import.
        "$ROOT/.venv/bin/pip" install -q -e "$ROOT" 2>/dev/null || \
            dim "could not refresh dependencies — run: make dev"
    fi
    cmd_restart
}

cmd_status() {
    local pid
    if pid="$(running_pid)"; then
        local since
        since="$(ps -p "$pid" -o etime= 2>/dev/null | tr -d ' ')"
        ok "running (pid $pid, up ${since:-?}, $(version))"
    else
        printf '%s✗ not running%s\n' "$RED" "$OFF"
        dim "start it with: awb start"
    fi
    if [[ -f "$LOG" ]]; then
        printf '\n%slast lines of %s%s\n' "$DIM" "$LOG" "$OFF"
        tail -n 8 "$LOG" | sed "s/^/  /"
    fi
}

cmd_logs() {
    [[ -f "$LOG" ]] || die "no log at $LOG yet"
    tail -n 40 -f "$LOG"
}

# The venv is deliberately not on PATH -- putting it there would shadow the
# system python for every shell. So the tools it installs are reached through
# `awb`, which knows where they live. Anything else means typing
# ~/lej-cc-tool/.venv/bin/lej-cc-whatever, which is how a useful command ends
# up unused.
run_tool() {
    local tool="$1"; shift
    local path="$ROOT/.venv/bin/$tool"
    [[ -x "$path" ]] || die "$tool is not installed — run: cd $ROOT && make dev"
    "$path" "$@"
}

cmd_doctor() { run_tool lej-cc-doctor "$@"; }
cmd_track()  { run_tool lej-cc-track "$@"; }
cmd_sync()   { run_tool lej-cc-sheet-sync "$@"; }
cmd_check()  { run_tool lej-cc-check "$@"; }
cmd_stats()  { run_tool lej-cc-stats "$@"; }

cmd_autostart() {
    # Called from ~/.bashrc, so it has to be fast and silent when there is
    # nothing to do -- nobody wants a terminal that pauses on every open.
    running_pid >/dev/null 2>&1 && return 0
    [[ -x "$BIN" && -f "$ROOT/.env" ]] || return 0

    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOG")"
    : >> "$LOG"
    spawn
    # No waiting for the ready line here: that is up to half a minute, and
    # this runs every time a terminal opens.
    printf '%s↻ AWB tracker was not running — started it.%s %sawb status%s\n' \
        "$GREEN" "$OFF" "$DIM" "$OFF"
}

BEGIN_MARK="# >>> AWB customs tracker >>>"
END_MARK="# <<< AWB customs tracker <<<"

cmd_install() {
    local rc="$HOME/.bashrc" autostart=1
    [[ "${1:-}" == "--no-autostart" ]] && autostart=0
    chmod +x "$ROOT/deploy/awbctl"
    touch "$rc"

    # Replace the whole block rather than appending to it, so installing
    # twice -- or from a second checkout -- leaves one copy, not three.
    if grep -qF "$BEGIN_MARK" "$rc"; then
        sed -i.bak "/$BEGIN_MARK/,/$END_MARK/d" "$rc"
        dim "replaced the previous block (backup: $rc.bak)"
    elif grep -q "^alias awb=" "$rc"; then
        sed -i.bak "/^alias awb=/d" "$rc"
        dim "replaced an existing 'awb' alias (backup: $rc.bak)"
    fi

    {
        printf '%s\n' "$BEGIN_MARK"
        printf "alias awb='%s/deploy/awbctl'\n" "$ROOT"
        if (( autostart )); then
            # Interactive shells only, and never fatal: a moved checkout must
            # not leave somebody with a terminal that errors on every open.
            printf "[[ \$- == *i* && -x '%s/deploy/awbctl' ]] && '%s/deploy/awbctl' autostart || true\n" \
                "$ROOT" "$ROOT"
        fi
        printf '%s\n' "$END_MARK"
    } >> "$rc"

    ok "installed the 'awb' shortcut into $rc"
    if (( autostart )); then
        ok "and it will start the bot when you open a terminal, if it is not running"
        dim "(don't want that? run: awbctl install --no-autostart)"
    fi
    printf '\nRun this once, or just open a new terminal:\n'
    printf '  %ssource ~/.bashrc%s\n\n' "$GREEN" "$OFF"
    usage
}

usage() {
    cat <<USAGE
Then, from anywhere:

  awb restart     stop it, start it, wait until it is really up
  awb update      pull the latest code, refresh deps, restart
  awb status      running? since when? which version?
  awb logs        follow the log (Ctrl-C to stop watching)
  awb start       start it
  awb stop        stop it (it says goodbye in Slack first)
  awb doctor      check the configuration and credentials

  awb track       start tracking a whole list of AWBs at once
  awb check       check one AWB from the command line, no Slack
  awb sync        write every tracked AWB into the Google Sheet
  awb stats       clearance times over the last N days

Those four pass everything after them straight through, so
`awb track --from-sheet --tab 2026.09 --dry-run` works as written.

Opening a terminal starts the bot if it is not running. That covers a
Windows restart or a sleep, but not a PC that is switched off -- which is
what the always-on server is for.
USAGE
}

case "${1:-status}" in
    start)    cmd_start ;;
    stop)     cmd_stop ;;
    restart)  cmd_restart ;;
    update)   cmd_update ;;
    status)   cmd_status ;;
    logs)     cmd_logs ;;
    autostart) cmd_autostart ;;
    doctor)   shift; cmd_doctor "$@" ;;
    track)    shift; cmd_track "$@" ;;
    check)    shift; cmd_check "$@" ;;
    sync)     shift; cmd_sync "$@" ;;
    stats)    shift; cmd_stats "$@" ;;
    install)  shift; cmd_install "$@" ;;
    -h|--help|help) usage ;;
    *)        die "unknown command: $1 (try: awb help)" ;;
esac
