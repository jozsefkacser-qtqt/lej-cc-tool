# ---- Slack -----------------------------------------------------------
# Bot token from OAuth & Permissions (scopes: commands, chat:write,
# files:write, app_mentions:read, chat:write.public)
SLACK_BOT_TOKEN=xoxb-...
# App-level token with connections:write, for Socket Mode
SLACK_APP_TOKEN=xapp-...
# Channel for global alerts (expired API key, changed file format). Optional.
SLACK_OPS_CHANNEL=C0123456789

# ---- PortGround ------------------------------------------------------
# Treat as a password: it is a bearer credential in a URL query string.
PORTGROUND_API_KEY=
PORTGROUND_BASE_URL=https://ecommerce.portground.com
# The export is generated on demand and is slow -- a 225-row workbook measured
# 112 seconds. Raise this if the preflight reports a timeout on a healthy call.
HTTP_TIMEOUT_SECONDS=300

# ---- polling ---------------------------------------------------------
FIRST_INTERVAL_MINUTES=15
REPEAT_INTERVAL_MINUTES=30
MAX_TRACKING_HOURS=48
POST_UNCHANGED_UPDATES=false
ATTACH_FILE_ON_CHANGE_ONLY=true
# How progress is drawn on the card:
#   grid  coloured emoji, PROGRESS_ROWS x PROGRESS_COLS of them
#   slim  two rows of fifty monospace blocks — exact to the percent and half
#         the width, but no colour: Slack cannot colour text, only emoji
#   bar   a single row of ten emoji — 1.1% has to take a whole cell, so it
#         draws twelve held shipments out of 1,079 as a tenth of the AWB
PROGRESS_STYLE=grid
# The shape of the grid. Three colours, one meaning each: green cleared,
# red taken by customs for examination, white no status yet. An all-green
# bar therefore means 100% cleared and nothing else does.
#   1 x 10  one row, 10% a cell           (default)
#   1 x 20  one row, 5% a cell
#   2 x 25  two rows, 2% a cell
#   4 x 25  four rows, exact to 1%
# The exact figures are always printed under the bar, so a coarse bar costs
# nothing but precision at a glance. Past ~25 columns a row wraps on a phone.
PROGRESS_ROWS=1
PROGRESS_COLS=10
# Your own cell characters, if you want them. The reason this exists is
# narrow CUSTOM Slack emoji: upload three thin images and you get a bar that
# is slim AND coloured, which no standard emoji can be. e.g. :cc-done:
PROGRESS_CELL_CLEARED=
PROGRESS_CELL_INSPECTION=
PROGRESS_CELL_OPEN=
# Name open shipments in the message only while there are at most this many;
# beyond it the message states the count and the chase sheet carries the list.
INLINE_LIST_THRESHOLD=10
# The short "still open" workbook: open lines only, chase columns only.
ATTACH_OPEN_SUMMARY=true
# The printable pick list when customs is holding parcels: which ones to
# pull, sorted by box, with a column to tick them off on the floor.
ATTACH_INSPECTION_LIST=true
# PortGround's export has no box id and no customer name — its 17 columns
# are shipment references and timestamps. Point this at a CSV or XLSX keyed
# by tracking number and the pick list fills both columns; without it they
# print blank, with a note on the sheet saying why. Column names are matched
# loosely, in English and Hungarian: Box / Box ID / Karton szám / location,
# Csomagszám / Tracking number for the key, Címzett neve / Consignee for the
# name. QT PARCEL LIST - LEJ works as-is, exported as CSV or XLSX.
# INSPECTION_LOOKUP_FILE=config/boxes.csv

# PortGround's original 17-column export, kept as the audit trail.
# Set false if you only want the short one.
ATTACH_FULL_WORKBOOK=true

# ---- email notifications (optional) ----------------------------------
# Leave SMTP_HOST empty to keep Slack-only. With Google Workspace use an
# app password on a dedicated account, never the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Must be an address the authenticated account may send as.
EMAIL_FROM=awb@qtlogistics.eu
# Addresses that receive every AWB, whoever started it. Comma-separated.
EMAIL_ALWAYS_TO=
# Mail on changed polls, on top of the first and final ones. Unchanged polls
# never mail, whatever this is set to.
EMAIL_ON_CHANGE=true
# Domains allowed to receive notifications. The mails carry invoice numbers,
# MRNs and consignee tracking numbers, so this is the difference between a
# mistyped address being annoying and being a data disclosure. Empty means no
# restriction, and the preflight warns when email is on without it.
EMAIL_ALLOWED_DOMAINS=qtlogistics.eu,skyqt.eu,qtzcustoms.eu

# ---- start a check by email (optional, off by default) ---------------
# Polls a shared mailbox and starts tracking for any AWB in the subject.
# Needs SMTP above as well -- the answer goes back by mail.
# Gmail/Workspace: imap.gmail.com, 993, and an app password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Where handled mail is filed. Empty leaves it in place, marked read.
IMAP_PROCESSED_FOLDER=
IMAP_POLL_SECONDS=60
# NOT OPTIONAL. Addresses or domains permitted to start a check. A From
# header is trivially forged and the reply carries customs data, so an empty
# list switches the trigger OFF rather than letting everyone in.
IMAP_ALLOWED_SENDERS=qtlogistics.eu
# Require SPF or DKIM to have passed, read from the Authentication-Results
# header your mail server writes. Only turn this off if it writes none.
IMAP_REQUIRE_AUTHENTICATION=true
# Most mails one sender can start per hour. Each one is a slow export.
IMAP_MAX_PER_SENDER_HOURLY=20
# The Slack channel email-triggered AWBs are posted to, so the team sees
# them too. Defaults to SLACK_STATUS_CHANNEL / SLACK_OPS_CHANNEL.
IMAP_TARGET_CHANNEL=

# ---- storage ---------------------------------------------------------
DATABASE_PATH=data/lej_cc.sqlite3
DOWNLOAD_DIR=data/downloads
DOWNLOAD_RETENTION_DAYS=30

# ---- Google Sheet: one row per AWB (optional) ------------------------
# Full setup, and the formulas that pull this into Daily Report_LEJ:
# docs/CENTRAL-SHEET.md
#
# A service account JSON key. Share the spreadsheet with that account's
# email address, as Editor.
# GOOGLE_CREDENTIALS_FILE=secrets/service-account.json
# The spreadsheet id from its URL: /spreadsheets/d/<THIS>/edit
#
# This must be the bot's own central sheet, never a hand-maintained report:
# the reports read from it with IMPORTRANGE. `lej-cc-doctor` warns if the id
# resolves to a title like "Daily Report".
# GOOGLE_SHEET_ID=1KNZfv8keVDz0DI3ruFhInLsTtkKnuEWsbFdBXb--1ss
# The tab the bot owns. Created on first use, written to exclusively;
# hand-maintained tabs are never touched.
GOOGLE_SHEET_TAB=CC_BOT
# GOOGLE_DRIVE_FOLDER_ID=

# ---- auto-detect: an AWB posted with no command at all ---------------
# Channel IDs where posting a bare AWB starts tracking, no /awb needed.
# Comma-separated; normally one dedicated channel. Empty = off everywhere.
# Find the ID at the bottom of the channel's "View channel details" panel.
# Needs the channels:history scope (see slack-app-manifest.yaml).
AUTODETECT_CHANNELS=
# Most AWBs one pasted message may start. Each one is a slow export.
AUTODETECT_MAX_PER_MESSAGE=10
# Post a short "how to use this" message in each auto-detect channel and keep
# it pinned. Rewritten in place on later restarts, never reposted.
PIN_EXPLAINER=true

# ---- escalation -------------------------------------------------------
# Shout when an AWB has not advanced for this long and is not finished.
# Measured from the last shipment that cleared, not from the start: a slow
# AWB that is still moving does not need anyone. 0 disables.
ESCALATION_AFTER_HOURS=4
# Prepended to the escalation message. A user group reads best.
# e.g. <!subteam^S012ABC>  ·  <!here>  ·  <!channel>
ESCALATION_MENTION=

# ---- knowing whether it is running -----------------------------------
# Channel for "online" / "going offline" announcements. Defaults to
# SLACK_OPS_CHANNEL; empty means no announcements.
SLACK_STATUS_CHANNEL=
# Dead-man's-switch URL, pinged on a schedule. When the pings stop, the
# service on the other end alerts you. This is the only part that survives
# the machine being switched off. healthchecks.io has a free tier.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_SECONDS=300

LOG_LEVEL=INFO
