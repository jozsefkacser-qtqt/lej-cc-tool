# ---- Slack -----------------------------------------------------------
# Bot token from OAuth & Permissions (scopes: commands, chat:write,
# files:write, app_mentions:read, chat:write.public)
SLACK_BOT_TOKEN=xoxb-...
# App-level token with connections:write, for Socket Mode
SLACK_APP_TOKEN=xapp-...
# Channel for global alerts (expired API key, changed file format). Optional.
SLACK_OPS_CHANNEL=C0123456789

# ---- PortGround ------------------------------------------------------
# Treat as a password: it is a bearer credential in a URL query string.
PORTGROUND_API_KEY=
PORTGROUND_BASE_URL=https://ecommerce.portground.com

# ---- polling ---------------------------------------------------------
FIRST_INTERVAL_MINUTES=15
REPEAT_INTERVAL_MINUTES=30
MAX_TRACKING_HOURS=48
POST_UNCHANGED_UPDATES=false
ATTACH_FILE_ON_CHANGE_ONLY=true
MAX_LISTED_HAWBS=15

# ---- storage ---------------------------------------------------------
DATABASE_PATH=data/lej_cc.sqlite3
DOWNLOAD_DIR=data/downloads
DOWNLOAD_RETENTION_DAYS=30

# ---- Google Workspace (optional: archive + dashboard) ----------------
# GOOGLE_CREDENTIALS_FILE=secrets/service-account.json
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_SHEET_ID=

LOG_LEVEL=INFO
