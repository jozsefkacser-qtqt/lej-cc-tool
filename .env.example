# ---- Slack -----------------------------------------------------------
# Bot token from OAuth & Permissions (scopes: commands, chat:write,
# files:write, app_mentions:read, chat:write.public)
SLACK_BOT_TOKEN=xoxb-...
# App-level token with connections:write, for Socket Mode
SLACK_APP_TOKEN=xapp-...
# Channel for global alerts (expired API key, changed file format). Optional.
SLACK_OPS_CHANNEL=C0123456789

# ---- PortGround ------------------------------------------------------
# Treat as a password: it is a bearer credential in a URL query string.
PORTGROUND_API_KEY=
PORTGROUND_BASE_URL=https://ecommerce.portground.com
# The export is generated on demand and is slow -- a 225-row workbook measured
# 112 seconds. Raise this if the preflight reports a timeout on a healthy call.
HTTP_TIMEOUT_SECONDS=300

# ---- polling ---------------------------------------------------------
FIRST_INTERVAL_MINUTES=15
REPEAT_INTERVAL_MINUTES=30
MAX_TRACKING_HOURS=48
POST_UNCHANGED_UPDATES=false
ATTACH_FILE_ON_CHANGE_ONLY=true
# Name open shipments in the message only while there are at most this many;
# beyond it the message states the count and the chase sheet carries the list.
INLINE_LIST_THRESHOLD=10
# The short "still open" workbook: open lines only, chase columns only.
ATTACH_OPEN_SUMMARY=true
# PortGround's original 17-column export, kept as the audit trail.
# Set false if you only want the short one.
ATTACH_FULL_WORKBOOK=true

# ---- email notifications (optional) ----------------------------------
# Leave SMTP_HOST empty to keep Slack-only. With Google Workspace use an
# app password on a dedicated account, never the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Must be an address the authenticated account may send as.
EMAIL_FROM=awb@qtlogistics.eu
# Addresses that receive every AWB, whoever started it. Comma-separated.
EMAIL_ALWAYS_TO=
# Mail on changed polls, on top of the first and final ones. Unchanged polls
# never mail, whatever this is set to.
EMAIL_ON_CHANGE=true

# ---- storage ---------------------------------------------------------
DATABASE_PATH=data/lej_cc.sqlite3
DOWNLOAD_DIR=data/downloads
DOWNLOAD_RETENTION_DAYS=30

# ---- Google Workspace (optional: archive + dashboard) ----------------
# GOOGLE_CREDENTIALS_FILE=secrets/service-account.json
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_SHEET_ID=

LOG_LEVEL=INFO
